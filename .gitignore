# Experiment outputs are versioned by SHA-256 manifests and external storage,
# not by Git. The current artifact tree is larger than 15 GB.
/artifacts/

# Python build, test, and environment state
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.venv/
venv/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local paper corpus; keep derived notes and source manifests in Git instead.
/docs/papers/*.pdf

# Runtime scratch files
*.tmp
*.log

# Local agent/editor settings
.claude/settings.local.json

# Shard worker runtime state (pid files and logs from K1 runs); kept locally, not versioned
/worker_logs/

# Secrets: API keys live only in local .env files
.env
.env.*
*.env

# Large or third-party-derived run outputs: regenerate with the scripts next to them
reports/**/P*_results.jsonl
reports/timeseries_deep_dive_2026-11-09/P1_units.json
